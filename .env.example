# Copy this file to .env and fill in your own key. Never commit the real .env file.
# Get a free OpenRouter key at https://openrouter.ai/settings/keys

OPENROUTER_API_KEY=your_openrouter_api_key_here

# "openrouter/free" is OpenRouter's Free Models Router: it auto-selects a
# free (:free-suffixed) model per request. You can pin a specific free
# model instead, e.g. meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_MODEL=openrouter/free

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
